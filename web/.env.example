# Copy to .env.local for development. On Vercel these are set in the dashboard.

# --- Database -------------------------------------------------------------
# Added automatically by the Neon integration in the Vercel marketplace.
# Use the POOLED connection string: serverless functions open a connection per
# request, and unpooled Postgres runs out of them under any real traffic.
# Leave both unset and the site builds from data/country-seed.json instead.
POSTGRES_URL=

# --- Payload --------------------------------------------------------------
# Any long random string. Changing it invalidates every login session.
# Generate one with:  openssl rand -base64 32
PAYLOAD_SECRET=

# --- Site -----------------------------------------------------------------
# The public origin. Used for the admin, CORS and absolute URLs.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
